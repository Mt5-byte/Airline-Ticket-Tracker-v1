# ───────────── Database ─────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skybird?schema=public"

# ───────────── Auth ─────────────
# Used by NextAuth to sign/encrypt JWTs. Generate: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic-link email (any SMTP provider: Resend, SendGrid, Mailgun, Postmark...)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Skybird <alerts@example.com>"

# ───────────── Flight data sources ─────────────
# Duffel — https://duffel.com (test token is fine for dev)
DUFFEL_ACCESS_TOKEN=""

# Amadeus — https://developers.amadeus.com (test env)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test"   # "test" or "production"

# X / Twitter — https://developer.x.com (Basic tier or higher)
X_BEARER_TOKEN=""
# Comma-separated usernames (no @). Defaults apply if empty.
X_DEAL_ACCOUNTS="SecretFlying,TheFlightDeal,airfarewatchdog,going,Scottscheapflt"

# ───────────── Worker ─────────────
# Protects the /api/cron/tick HTTP trigger. Generate: `openssl rand -hex 16`
# REQUIRED in production if you trigger ticks over HTTP — the endpoint refuses
# to run unauthenticated when NODE_ENV=production and this is unset.
CRON_SECRET=""

# ───────────── App ─────────────
APP_URL="http://localhost:3000"
